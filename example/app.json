{
  "expo": {
    "name": "expo-screen-time-example",
    "slug": "expo-screen-time-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "expo-screen-time-example",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.magrinj.exposcreentime.example",
      "appleTeamId": "H8W629E3PM",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.magrinj.exposcreentime.example"
        ],
        "com.apple.developer.family-controls": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "expo.modules.screentime.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "../app.plugin.js",
      [
        "@bacons/apple-targets",
        {
          "libraryTargets": [
            ".."
          ]
        }
      ],
      "./plugins/disable-extension-previews",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
