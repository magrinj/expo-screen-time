{
  "name": "expo-screen-time",
  "version": "0.2.0",
  "description": "App blocking, schedules, shields and usage reports for Expo on iOS (Screen Time) and Android.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "plugin/build",
    "src",
    "!src/__tests__",
    "!src/report/__tests__",
    "plugin/src",
    "!plugin/src/ios/__tests__",
    "!plugin/src/android/__tests__",
    "ios",
    "targets",
    "android",
    "!android/build",
    "!android/.gradle",
    "!android/src/test",
    "app.plugin.js",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "expo-module build && expo-module build plugin",
    "prepack": "EXPO_NONINTERACTIVE=1 bun run build",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs src plugin/src",
    "test": "expo-module test && expo-module test plugin && tsc -p test/reference-apps",
    "test:swift": "scripts/swift-tests/run.sh",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-screen-time",
    "ExpoScreenTime",
    "ios",
    "android",
    "screen-time",
    "parental-control",
    "app-blocker",
    "digital-wellbeing",
    "family-controls",
    "usage-stats"
  ],
  "repository": "https://github.com/magrinj/expo-screen-time.git",
  "bugs": {
    "url": "https://github.com/magrinj/expo-screen-time/issues"
  },
  "author": "Jérémy Magrin <contact@magrin.fr> (magrinj)",
  "license": "MIT",
  "homepage": "https://github.com/magrinj/expo-screen-time.git#readme",
  "dependencies": {
    "@expo/plist": "^0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo-module-scripts": "^56.0.8",
    "expo": "~58.0.25",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": "*",
    "react-native": "*"
  },
  "overrides": {
    "@swc/core": "~1.15.47"
  },
  "packageManager": "bun@1.3.14",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.3.14",
      "onFail": "warn"
    }
  }
}
