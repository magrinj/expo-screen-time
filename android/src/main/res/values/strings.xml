<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The engine's persistent notice. Consumers can override these in their own res/values. -->
  <string name="expo_st_notice_channel">Screen Time protection</string>
  <string name="expo_st_notice_title">Screen Time protection is active</string>
  <string name="expo_st_notice_text">Restrictions you set are being enforced.</string>
  <string name="expo_st_device_admin_explanation">Keeps the protection from being force-stopped or removed without turning it off here first.</string>
  <!-- The confirmation the system shows when the user deactivates the device admin. -->
  <string name="expo_st_device_admin_disable_warning">Turning this off lets the protection be force-stopped or uninstalled. Restrictions you set keep running until then.</string>
  <!--
    The accessibility detector (config plugin option `android.accessibilityEngine`):
    the service's name in Settings › Accessibility, and the description shown next
    to its toggle, which Google Play reads against the declaration (the second
    sentence onwards of the in-app disclosure the app shows before Settings).
  -->
  <string name="expo_st_accessibility_label">Screen Time protection</string>
  <string name="expo_st_accessibility_description">Android tells this app when one of the apps you chose to restrict opens, including in a work profile, Private Space or a cloned app, so it can show the blocking screen. The service does not read what is on your screen. You can turn it off at any time here.</string>
  <!-- The picker (ActivityPicker) and the token label. -->
  <string name="expo_st_picker_search_hint">Search apps</string>
  <string name="expo_st_picker_empty">No apps to show</string>
  <string name="expo_st_picker_no_match">No apps match your search</string>
  <string name="expo_st_label_unavailable">Unavailable app</string>
  <!-- The report view without a template (the iOS placeholder text). -->
  <string name="expo_st_report_no_template">No custom template set</string>
  <!-- The shield's built-in texts, used where the ShieldConfig sets none. -->
  <string name="expo_st_shield_title">Blocked</string>
  <string name="expo_st_shield_subtitle">This app is blocked right now.</string>
  <string name="expo_st_shield_close">OK</string>
  <!--
    The shield over a restriction target (denyAppRemoval: the uninstall dialog;
    denyAppInstallation: the stores and the package installer). The user did not
    choose these apps, so the texts say what happened and where to turn it off:
    %1$s is this app's label. Consumers override them in their own res/values.
  -->
  <string name="expo_st_shield_removal_title">Removing apps is turned off</string>
  <string name="expo_st_shield_installation_title">Installing apps is turned off</string>
  <string name="expo_st_shield_restriction_subtitle">Turn it back on in %1$s.</string>
</resources>
