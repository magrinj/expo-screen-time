<?xml version="1.0" encoding="utf-8"?>
<!--
  Static declarations the Android implementation needs in every consumer app.
  Gradle's manifest merger folds this file into the app's manifest, so these
  entries are present once whatever the number of prebuilds: that is what makes
  them inherently idempotent, and why they live here rather than in the config
  plugin (plugin/src/android/, which adds the optional, app-level bits and
  removes the entries of the features `android.features` leaves out).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Usage access (Settings toggle, read through AppOps): the usageStats engine. -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <!-- Display over other apps: the background-activity-launch exemption the shield needs. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- The engine's foreground service (Android 14+: typed as specialUse). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Android 13+: the persistent notice of the engine. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Restart the engine after a reboot. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!--
    Package visibility (Android 11+): the launchable apps the picker lists,
    and the home apps, so the usage report and the shield policy can tell a
    launcher from an app (a launcher is not visible otherwise: it has no
    launcher icon of its own); then the targets of the app-control
    restrictions (RestrictionTargets): the uninstall dialog (ACTION_DELETE
    on a package), the package installer (ACTION_INSTALL_PACKAGE of an APK)
    and the stores (ACTION_VIEW of a market://details link). Deliberately
    not QUERY_ALL_PACKAGES, which Play restricts.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
    <intent>
      <action android:name="android.intent.action.DELETE" />
      <data android:scheme="package" />
    </intent>
    <intent>
      <action android:name="android.intent.action.INSTALL_PACKAGE" />
      <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="market" android:host="details" />
    </intent>
  </queries>

  <application>
    <!--
      The enforcement engine, in its own process: the React Native process
      stays killable without taking the engine down.
      `specialUse` with its mandatory subtype property; Android 15+ lets a
      specialUse service start from BOOT_COMPLETED.
    -->
    <service
      android:name="expo.modules.screentime.ScreenTimeEngineService"
      android:exported="false"
      android:foregroundServiceType="specialUse"
      android:process=":screentime"
      android:stopWithTask="false">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Blocks the apps the user chose to restrict, on the schedule they set, while a restriction is active, and, when the user turns it on, the screens that remove or install apps" />
    </service>

    <!--
      The shield: drawn by the library over the blocked app, in
      the engine's process (already alive, so the first frame is cheap and
      the React Native process is never started for it). Not in Recents, its
      own task, no starting window (theme), resizeable so it can take a
      split-screen pane. The task affinity is per app so two consumers never
      share a task.
    -->
    <activity
      android:name="expo.modules.screentime.ShieldActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:taskAffinity="${applicationId}.expo_st_shield"
      android:process=":screentime"
      android:resizeableActivity="true"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
      android:theme="@style/ExpoScreenTime.Shield" />

    <!--
      The picture-in-picture counter-measure: enters PiP to evict the blocked
      app's pinned window (one per display), then finishes. Its own task, so
      only it is pinned, never the shield.
    -->
    <activity
      android:name="expo.modules.screentime.PipEvictorActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:launchMode="singleInstance"
      android:taskAffinity="${applicationId}.expo_st_pip"
      android:process=":screentime"
      android:resizeableActivity="true"
      android:supportsPictureInPicture="true"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
      android:theme="@style/ExpoScreenTime.PipEvictor" />

    <!--
      Brings the engine back after a reboot or an update when the state store
      says it should run. Not exported: system broadcasts still reach it
      (WorkManager's RescheduleReceiver uses the same shape).
    -->
    <receiver
      android:name="expo.modules.screentime.ScreenTimeRestartReceiver"
      android:exported="false"
      android:process=":screentime">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!--
      Device admin with no policy: an active admin cannot be force-stopped
      from Settings and must be deactivated before the app can be uninstalled
      (the `deviceAdmin` permission step).
    -->
    <receiver
      android:name="expo.modules.screentime.ScreenTimeDeviceAdminReceiver"
      android:exported="true"
      android:permission="android.permission.BIND_DEVICE_ADMIN">
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/expo_st_device_admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
