<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <application>
    <service android:name="expo.modules.screentime.ScreenTimeDnsFilterService"
      android:exported="true" android:process=":screentime" android:permission="android.permission.BIND_VPN_SERVICE">
      <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
      <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
    </service>
    <receiver android:name="expo.modules.screentime.WebPreviewReceiver" android:exported="true" android:process=":screentime"
      android:permission="android.permission.DUMP">
      <intent-filter><action android:name="expo.modules.screentime.action.WEB_BOOT_POLICY" /></intent-filter>
    </receiver>
  </application>
</manifest>
