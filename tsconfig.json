{
  "extends": "expo-module-scripts/tsconfig.base",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",
    // The shared base turns on incremental builds with a .tsbuildinfo outside
    // build/: after `expo-module clean` tsc then sees "up to date" and emits
    // nothing. Full builds are fast here.
    "incremental": false,
    // Not "expo-source": that condition points Expo packages at their TS
    // sources (meant for the Expo monorepo) and drags their optional deps in.
    "customConditions": ["react-native-legacy-deep-imports", "react-native-unstable-internals"]
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*", "**/__rsc_tests__/*"]
}
