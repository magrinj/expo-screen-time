{
  // Type-checks the reference apps against src/: an API change that breaks a
  // real app shape fails `bun run test`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "expo-screen-time": ["../../src/index.ts"]
    }
  },
  "include": ["apps/**/*.tsx"]
}
